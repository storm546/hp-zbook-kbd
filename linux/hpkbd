#!/usr/bin/env python3
"""Control the audited ZBook kernel driver's LED interface as your normal user."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import sys
import tempfile
import time

LED = Path('/sys/class/leds/hp::kbd_backlight')
STATE = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'hpkbd'
EFFECTS = ('wave', 'breathing', 'colorloop', 'sparkle', 'raindrop', 'ripple', 'ghosting', 'omenx', 'confetti', 'sun', 'swipe')
DEFAULT = {'effect': 'colorloop', 'colors': [], 'rgb': 'FFFFFF', 'brightness': 255, 'on': True}


def rgb(value):
    value = value.removeprefix('#')
    if not re.fullmatch('[0-9a-fA-F]{6}', value):
        raise argparse.ArgumentTypeError('colour must be six hex digits')
    return value.upper()


def load():
    if not (STATE / 'state.json').exists():
        return DEFAULT.copy()
    s = json.loads((STATE / 'state.json').read_text())
    if (s.get('effect') not in ('static', *EFFECTS) or
        type(s.get('brightness')) is not int or not 1 <= s['brightness'] <= 255 or
        type(s.get('on')) is not bool or not isinstance(s.get('colors'), list) or len(s['colors']) > 6):
        raise ValueError('invalid saved state')
    s['rgb'] = rgb(s['rgb'])
    s['colors'] = [rgb(c) for c in s['colors']]
    return s


def save(s):
    fd, name = tempfile.mkstemp(dir=STATE, prefix='.state-')
    try:
        with os.fdopen(fd, 'w') as f:
            json.dump(s, f, indent=2)
            f.write('\n')
        os.replace(name, STATE / 'state.json')
    finally:
        if os.path.exists(name):
            os.unlink(name)


def apply(s):
    if s['effect'] == 'static':
        (LED / 'effect').write_text('static\n')
        v = int(s['rgb'], 16)
        (LED / 'multi_intensity').write_text(' '.join(str(v >> n & 255) for n in (16, 8, 0)) + '\n')
    else:
        (LED / 'effect').write_text(' '.join([s['effect'], *s['colors']]) + '\n')
    (LED / 'brightness').write_text(str(s['brightness'] if s['on'] else 0) + '\n')


def main():
    p = argparse.ArgumentParser(description=__doc__)
    sub = p.add_subparsers(dest='command', required=True)
    for cmd in ('status', 'on', 'off', 'toggle', 'restore'):
        sub.add_parser(cmd)
    color = sub.add_parser('color')
    color.add_argument('rgb', type=rgb)
    color.add_argument('-b', type=int, choices=range(1, 101), default=100, metavar='1-100')
    effect = sub.add_parser('effect')
    effect.add_argument('name', choices=EFFECTS)
    effect.add_argument('colors', nargs='*', type=rgb)
    brightness = sub.add_parser('brightness')
    brightness.add_argument('percent', type=int, choices=range(101), metavar='0-100')
    args = p.parse_args()
    if args.command == 'effect' and len(args.colors) > 6:
        p.error('at most six colours are allowed')
    try:
        if args.command == 'restore':
            for _ in range(100):
                if os.access(LED / 'effect', os.W_OK):
                    break
                time.sleep(.1)
        if args.command == 'status':
            print('brightness:', (LED / 'brightness').read_text().strip() + '/255')
            print('RGB:', (LED / 'multi_intensity').read_text().strip())
            print('effects:', (LED / 'effect').read_text().strip())
            return
        STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
        with (STATE / 'lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            s = load()
            if args.command == 'color':
                s.update(effect='static', rgb=args.rgb, colors=[], brightness=max(1, args.b * 255 // 100), on=True)
            elif args.command == 'effect':
                s.update(effect=args.name, colors=args.colors, on=True)
            elif args.command == 'brightness':
                s['on'] = args.percent > 0
                if args.percent:
                    s['brightness'] = max(1, args.percent * 255 // 100)
                (LED / 'brightness').write_text(str(s['brightness'] if s['on'] else 0) + '\n')
                save(s)
                return
            elif args.command in ('on', 'off', 'toggle'):
                current = int((LED / 'brightness').read_text())
                s['on'] = args.command == 'on' or (args.command == 'toggle' and not current)
                (LED / 'brightness').write_text(str(s['brightness'] if s['on'] else 0) + '\n')
                save(s)
                return
            apply(s)
            save(s)
    except (OSError, ValueError, KeyError, TypeError, argparse.ArgumentTypeError) as error:
        p.exit(1, f'hpkbd: {error}\n')


if __name__ == '__main__':
    main()
